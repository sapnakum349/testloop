
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ShieldX Antivirus - Stay Protected</title>
<meta name="description" content="ShieldX Antivirus website template for digital security and privacy.">

<style>
:root {
  --primary: #5b50f5;
  --primary-dark: #4438ca;
  --dark: #11162a;
  --text: #687087;
  --light: #f5f6ff;
  --green: #10b981;
  --border: #e7e8f0;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; scroll-padding-top: 85px; }

body {
  font-family: Arial, sans-serif;
  color: var(--dark);
  line-height: 1.6;
}

a { text-decoration: none; color: inherit; }
button { font: inherit; cursor: pointer; }
.container { width: min(1120px, 90%); margin: auto; }

header {
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid var(--border);
}

nav {
  min-height: 76px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.logo {
  font-size: 25px;
  font-weight: 800;
  letter-spacing: -1px;
}

.logo span { color: var(--primary); }

.logo-icon {
  display: inline-grid;
  place-items: center;
  width: 36px;
  height: 36px;
  background: var(--primary);
  color: white;
  border-radius: 11px;
  margin-right: 6px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 25px;
  font-size: 14px;
  font-weight: 600;
}

.nav-links a:hover { color: var(--primary); }

.btn {
  display: inline-block;
  border: none;
  border-radius: 10px;
  background: var(--primary);
  color: white;
  padding: 13px 22px;
  font-weight: 700;
  transition: .2s;
}

.btn:hover { background: var(--primary-dark); transform: translateY(-2px); }

.btn-light {
  background: white;
  color: var(--primary);
  border: 1px solid var(--primary);
}

.btn-light:hover { color: white; }

.menu-toggle {
  display: none;
  border: 0;
  background: transparent;
  font-size: 26px;
}

/* Hero */
.hero {
  padding: 90px 0;
  background:
    radial-gradient(circle at 85% 20%, #e4e2ff, transparent 32%),
    linear-gradient(120deg, #fbfbff, #f0f0ff);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  align-items: center;
  gap: 55px;
}

.tag {
  display: inline-block;
  padding: 7px 13px;
  border-radius: 25px;
  background: #e9e7ff;
  color: var(--primary);
  font-weight: 800;
  font-size: 12px;
  margin-bottom: 20px;
}

h1 {
  font-size: clamp(40px, 5vw, 64px);
  line-height: 1.1;
  letter-spacing: -2px;
  margin-bottom: 22px;
}

.highlight { color: var(--primary); }

.hero-copy {
  color: var(--text);
  font-size: 17px;
  max-width: 540px;
  margin-bottom: 28px;
}

.hero-buttons { display: flex; flex-wrap: wrap; gap: 12px; }

.trust {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 28px;
  font-size: 13px;
  color: var(--text);
}

.trust-icon {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  background: #dcfce9;
  color: #078b59;
  border-radius: 50%;
  font-size: 20px;
}

.security-card {
  background: white;
  border: 1px solid #e5e4ff;
  border-radius: 25px;
  padding: 32px;
  text-align: center;
  box-shadow: 0 25px 70px #5b50f51c;
}

.status {
  display: inline-block;
  padding: 6px 12px;
  border-radius: 25px;
  background: #dcfce9;
  color: #078b59;
  font-size: 12px;
  font-weight: 800;
}

.shield {
  width: 145px;
  height: 165px;
  margin: 25px auto;
  display: grid;
  place-items: center;
  background: linear-gradient(145deg, #827aff, #493ddd);
  color: white;
  font-size: 65px;
  clip-path: polygon(50% 0, 94% 18%, 88% 65%, 70% 86%, 50% 100%, 30% 86%, 12% 65%, 6% 18%);
}

.security-card h3 { font-size: 23px; margin-bottom: 8px; }
.security-card p { font-size: 13px; color: var(--text); }

.mini-progress {
  height: 7px;
  background: #ecebff;
  border-radius: 10px;
  margin: 22px 0;
  overflow: hidden;
}

.mini-progress div {
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--green));
}

.card-stats {
  display: flex;
  justify-content: space-around;
  gap: 10px;
}

.card-stats strong { display: block; font-size: 19px; }
.card-stats small { color: var(--text); font-size: 11px; }

/* General sections */
section { padding: 80px 0; }

.heading {
  text-align: center;
  max-width: 650px;
  margin: 0 auto 42px;
}

.heading h2 {
  font-size: clamp(30px, 4vw, 43px);
  letter-spacing: -1px;
  line-height: 1.2;
  margin-bottom: 15px;
}

.heading p { color: var(--text); }

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  padding: 30px 0;
}

.stat { text-align: center; }
.stat h3 { font-size: 31px; color: var(--primary); }
.stat p { color: var(--text); font-size: 14px; }

.features, .pricing { background: var(--light); }

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.feature {
  padding: 28px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 17px;
  transition: .25s;
}

.feature:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 35px #22244d0e;
}

.feature-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: #edecff;
  font-size: 26px;
  margin-bottom: 18px;
}

.feature h3 { margin-bottom: 9px; font-size: 19px; }
.feature p { color: var(--text); font-size: 14px; }

/* Scanner demo */
.scanner {
  max-width: 700px;
  margin: auto;
  padding: 32px;
  border: 1px solid var(--border);
  border-radius: 22px;
  box-shadow: 0 15px 45px #17193a0c;
}

.scanner-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.demo-badge {
  background: #fff2cc;
  color: #93610a;
  padding: 5px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 800;
}

.scan-display { text-align: center; padding: 30px 0; }

.scan-circle {
  width: 105px;
  height: 105px;
  margin: 0 auto 20px;
  display: grid;
  place-items: center;
  border: 7px solid #e7e5ff;
  border-top-color: var(--primary);
  border-radius: 50%;
  font-size: 32px;
}

.scan-circle.running { animation: rotate 1s linear infinite; }

@keyframes rotate { to { transform: rotate(360deg); } }

.scan-display h3 { font-size: 23px; margin-bottom: 8px; }
.scan-display p { color: var(--text); font-size: 14px; }

.progress-track {
  height: 9px;
  background: #ededf7;
  border-radius: 20px;
  overflow: hidden;
  margin: 20px 0 8px;
}

.progress-bar {
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, var(--primary), var(--green));
  transition: width .2s;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  color: var(--text);
  font-size: 12px;
}

.scan-button { width: 100%; margin-top: 23px; }
.scan-button:disabled { opacity: .65; cursor: wait; }

.scan-result {
  display: none;
  margin-top: 18px;
  padding: 14px;
  border-radius: 10px;
  background: #e7fff3;
  color: #08784f;
  font-size: 13px;
}

/* Pricing */
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
  align-items: stretch;
}

.price-card {
  position: relative;
  padding: 30px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 19px;
}

.price-card.popular { border: 2px solid var(--primary); }

.popular-tag {
  position: absolute;
  right: 18px;
  top: -14px;
  padding: 5px 12px;
  border-radius: 20px;
  background: var(--primary);
  color: white;
  font-size: 11px;
  font-weight: 800;
}

.price-card h3 { font-size: 21px; }
.price-description { color: var(--text); font-size: 13px; margin: 8px 0 18px; }
.price { font-size: 38px; font-weight: 800; }
.price small { color: var(--text); font-size: 13px; font-weight: 400; }

.price-card ul { list-style: none; margin: 24px 0; }
.price-card li { font-size: 14px; margin: 12px 0; }
.price-card li::before { content: "?"; color: var(--green); font-weight: 900; margin-right: 9px; }
.price-card .btn { width: 100%; text-align: center; }

/* FAQ */
.faq-list { max-width: 760px; margin: auto; }
.faq-item { border-bottom: 1px solid var(--border); }

.faq-question {
  width: 100%;
  padding: 21px 0;
  border: 0;
  background: white;
  display: flex;
  justify-content: space-between;
  text-align: left;
  gap: 12px;
  font-weight: 700;
  font-size: 16px;
}

.faq-question span { color: var(--primary); font-size: 22px; }
.faq-answer { display: none; color: var(--text); font-size: 14px; padding-bottom: 20px; }
.faq-item.active .faq-answer { display: block; }

/* Call to action */
.cta { padding-top: 0; }

.cta-box {
  padding: 55px 25px;
  border-radius: 25px;
  background: linear-gradient(120deg, #625bff, #4438ca);
  text-align: center;
  color: white;
}

.cta-box h2 { font-size: clamp(28px, 4vw, 42px); margin-bottom: 12px; }
.cta-box p { color: #e5e4ff; margin-bottom: 24px; }
.cta-box .btn { background: white; color: var(--primary-dark); }

/* Footer */
footer { background: #111528; color: white; padding: 45px 0 20px; }

.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr;
  gap: 35px;
  padding-bottom: 30px;
}

.footer-about p { color: #a8afc5; font-size: 14px; margin-top: 15px; max-width: 350px; }
footer h4 { margin-bottom: 15px; }

.footer-links {
  display: flex;
  flex-direction: column;
  gap: 10px;
  color: #a8afc5;
  font-size: 14px;
}

.footer-links a:hover { color: white; }

.copyright {
  border-top: 1px solid #30354a;
  padding-top: 20px;
  color: #a8afc5;
  font-size: 12px;
  text-align: center;
}

@media (max-width: 850px) {
  .hero-grid { grid-template-columns: 1fr; gap: 40px; }
  .security-card { max-width: 500px; width: 100%; margin: auto; }
  .feature-grid { grid-template-columns: repeat(2, 1fr); }
  .pricing-grid { grid-template-columns: 1fr; max-width: 500px; margin: auto; gap: 28px; }
  .footer-grid { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 600px) {
  nav { min-height: 68px; }
  .menu-toggle { display: block; }
  .nav-links {
    display: none;
    position: absolute;
    top: 68px;
    left: 0;
    width: 100%;
    padding: 22px 5%;
    background: white;
    border-bottom: 1px solid var(--border);
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .nav-links.open { display: flex; }
  .nav-links .btn { width: 100%; text-align: center; }
  .hero { padding: 65px 0; }
  h1 { letter-spacing: -1px; }
  section { padding: 60px 0; }
  .feature-grid { grid-template-columns: 1fr; }
  .stats { grid-template-columns: repeat(2, 1fr); gap: 25px; }
  .scanner { padding: 22px; }
  .footer-grid { grid-template-columns: 1fr; }
}
</style>
</head>

<body>

<header>
  <nav class="container">
    <a href="#home" class="logo"><span class="logo-icon">?</span>Shield<span>X</span></a>

    <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu"
      aria-expanded="false">?</button>

    <div class="nav-links" id="navLinks">
      <a href="#home">Home</a>
      <a href="#features">Features</a>
      <a href="#scanner">Scanner</a>
      <a href="#pricing">Pricing</a>
