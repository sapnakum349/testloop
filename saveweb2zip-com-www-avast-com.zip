      <a href="#pricing" class="btn">Get Protected ?</a>
    </div>
  </nav>
</header>

<main>
  <section class="hero" id="home">
    <div class="container hero-grid">
      <div>
        <span class="tag">? NEXT-GENERATION SECURITY</span>
